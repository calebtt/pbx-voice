# Copy to the state directory as secrets.env (mode 0600). Variables set in the
# environment win over this file. Tool arguments never carry any of these.

SIP_SERVER=pbx.example.com
# SIP_PORT=5060
SIP_USERNAME=201
SIP_PASSWORD=change-me
# SIP_FROMNAME=Wake-up
# Local UDP port to bind; 0 = any free port. Do not use 5060 on the PBX host itself.
# SIP_LOCAL_PORT=0

# xAI API key for text-to-speech and speech-to-text.
XAI_API_KEY=
