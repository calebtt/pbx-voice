<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>pbx-voice</AssemblyName>
    <RootNamespace>PbxVoice</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PbxVoice.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The default conversation prompt; an operator's copy in the state directory overrides it. -->
    <EmbeddedResource Include="Conversation/conversation-prompt.txt" LogicalName="PbxVoice.conversation-prompt.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The MCP front: Streamable HTTP for agents, stdio for the local shim. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- SipBotLib is a submodule pinned to a release tag (see .gitmodules). -->
    <ProjectReference Include="../../external/SipBotLib/SipBotLib.csproj" />
    <!-- Silero VAD (V5, 8 kHz) for reply detection; CPU ONNX Runtime (see Directory.Build.props). -->
    <ProjectReference Include="../../external/MinimalSileroVad/MinimalSileroVAD.Core/MinimalSileroVAD.Core.csproj" />
  </ItemGroup>

</Project>
